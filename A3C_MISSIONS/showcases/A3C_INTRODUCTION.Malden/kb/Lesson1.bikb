		text="YOU CAN SELECT AVAILABLE BUILDING POSITIONS CLOSEST TO THE POSITION YOU ARE LOOKING AT. TRY LOOKING AT DIFFERENT POSITIONS OF THE BUILDING.";
		speech[]={"\sound\Ll_SNAP_BUILDING_02.ogg"};
