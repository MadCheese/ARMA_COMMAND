	class L3101
	{
		text="IN THIS LESSON WE ARE GOING TO LOOK AT STRATEGIC MODE, SPECIFICALLY ON SQUAD LEVEL. STRATEGIC MODE ENABLES YOU TO PLAN AND EXECUTE ELABORATE ACTIONS.";
		speech[]={"\sound\L3101.ogg"};
		class Arguments {};
	};
	
	class L31011
	{
		text="THE MAP-OVERLAY IS ENABLED BY DEFAULT. YOU CAN HIDE IT BY PRESSING THE �C� BUTTON ON YOUR KEYBOARD.";
		speech[]={"\sound\L31011.ogg"};
		class Arguments {};
	};
	
	class L31012
	{
		text="THE HIDDEN STATE IS STORED IN YOUR PROFILE AND YOU WILL NOT SEE THE OVERLAY AGAIN UNTIL YOU MANUALLY TOGGLE IT BACK.";
		speech[]={"\sound\L31012.ogg"};
