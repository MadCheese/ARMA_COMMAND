	//////////////////////////////////////////////
	//////////  LESSON 1: TACTICAL MODE //////////
	//////////////////////////////////////////////
	
	
	
	class Ll_01
	{
		text="WELCOME TO AFB COLUMBUS SERGEANT. MY NAME IS CAPTAIN STEVEN COLLINS - TODAY WE ARE GOING TO SHARPEN UP YOUR LEADERSHIP SKILLS!";
		speech[]={"\sound\Ll_01.ogg"};
		class Arguments {};
	};
	class Ll_02
	{
		text="YOU HAVE THREE NEW COMMANDING ASSETS AT YOUR DISPOSAL - TACTICAL MODE, MAP PLANNING AND THE RADIAL MENU.";
		speech[]={"\sound\Ll_02.ogg"};
		class Arguments {};
	};
	
	
	class Ll_03
	{
		text="CONTROL HINTS WILL BE DISPLAYED AT ALL TIMES SO YOU DON'T LOSE TRACK. ";
		speech[]={"\sound\Ll_03.ogg"};
		class Arguments {};
	};
	////////////////////////////////////
	
		
	class Ll_HUD_Intro_01
	{
		text="WELCOME TO A LESSON IN SQUAD MOVEMENT, SERGEANT. TACTICAL MODE IS WHERE YOU POSITION YOUR UNITS IN PRECISE LOCATIONS WHILE OPERATING IN 3D-SPACE.";
		speech[]={"\sound\Ll_HUD_Intro_01.ogg"};
		class Arguments {};
	};
	
	
	
	class Ll_HUD_Intro_02
	{
		text="YOU WILL BE USING ENVIRONMENT SENSITIVE INDICATORS THAT SHOW YOU WHERE YOUR UNITS WILL MOVE, WHERE THEY WILL ORIENT THEMSELVES AND WHAT STANCE THEY WILL TAKE.";
		speech[]={"\sound\Ll_HUD_Intro_02.ogg"};
		class Arguments {};
	};
	
	class Ll_HUD_SEL_IND
	{
		text="FIRST, YOU CAN SELECT UNITS INDIVIDUALLY, SIMILAR TO ARMA'S VANILLA COMMANDS. HOLD DOWN CTRL AND PRESS F2 TO SELECT ONLY UNIT 2 IN TACTICAL!";
		speech[]={"\sound\Ll_HUD_SEL_IND.ogg"};
		class Arguments {};
	};
	
	
	class Ll_HUD_ROT_IND 
	{
		text="YOU CAN ROTATE THE SELECTION WITH YOUR MOUSEWHEEL. TRY IT RIGHT NOW.";
		speech[]={"\sound\Ll_HUD_ROT_IND.ogg"};
		class Arguments {};
	};
	
	class Ll_HUD_MOVE_IND
	{
		text="GOOD JOB - NOW SEND THE UNIT 2 TO THE MARKED POSITION BY PRESSING SPACE-BAR.";
		speech[]={"\sound\Ll_HUD_MOVE_IND.ogg"};
		class Arguments {};
	};
	
	class Ll_HUD_SEL_ALL
	{
		text="THE REAL POWER OF TACTICAL MODE LIES IN BULK MANAGEMENT. SELECT ALL UNITS AT ONCE! (KEYBIND HINT TOP LEFT SCREEN)";
		speech[]={"\sound\Ll_HUD_SEL_ALL.ogg"};
		class Arguments {};
	};
	
	class Ll_HUD_SPACING
	{
		text="IF YOU HOLD DOWN CTRL AND SCROLL YOUR MOUSEWHEEL, YOU CAN CHANGE THE FORMATION SPACING.";
		speech[]={"\sound\Ll_HUD_SPACING.ogg"};
		class Arguments {};
	};
	
	class Ll_HUD_UI_INTRO
	{
		text="YOU MAY HAVE RECOGNIZED THE UI ELEMENT IN THE BOTTOM - YOU CAN INTERACT WITH THIS UI BY HOLDING DOWN SHIFT.";
		speech[]={"\sound\Ll_HUD_UI_INTRO.ogg"};
		class Arguments {};
	};
	class Ll_HUD_UI_FNC
	{
		text="THIS MENU STAYS INTERACTIVE AS LONG AS YOU HOLD DOWN SHIFT.";
		speech[]={"\sound\Ll_HUD_UI_FNC.ogg"};
		class Arguments {};
	};
	class Ll_HUD_UI_CHANGEFORM
	{
		text="NOW CHANGE THE FORMSECTOR BY CLICKING ON THE BIG ROUND ICON IN THE MIDDLE. SELECT THE CIRCLE FORMATION WITH MOUSEBUTTONS OR MOUSEWHEEL";
		speech[]={"\sound\Ll_HUD_UI_CHANGEFORM.ogg"};
		class Arguments {};
	};
	class Ll_HUD_UI_CHANGESTANCE
	{
		text="VERY GOOD - NOW CHANGE THE STANCES - THE FIRST ICON REPRESENTS TRAVEL STANCE, THE SECOND REPRESENTS ARRIVAL STANCE. CHANGE THE ARRIVAL STANCE TO CROUCH";
		speech[]={"\sound\Ll_HUD_UI_CHANGESTANCE.ogg"};
		class Arguments {};
	};
	class Ll_HUD_UI_ORDER
	{
		text="NOW LET GO OF SHIFT AND CONFIRM THE ORDER. THE UNITS WILL CROUCH ON ARRIVAL";
		speech[]={"\sound\Ll_HUD_UI_ORDER.ogg"};
		class Arguments {};
	};
	
	
	class Ll_SEL_RED
	{
		text="FIRE-TEAM MANAGEMENT IS ANOTHER STRENGTH OF TACTICAL MODE. PLEASE SELECT TEAM RED NOW.";
		speech[]={"\sound\Ll_SEL_RED.ogg"};
		class Arguments {};
	};
	
	class Ll_SNAP_HESCO
	{
		text="THE INDICATORS SNAP THE ENVIRONMENT TO ALIGN YOUR FORMATION WITH BUILDINGS AND OTHER OBJECTS. DRAG THEM ON AGAINST A HESCO BARRIER.";
