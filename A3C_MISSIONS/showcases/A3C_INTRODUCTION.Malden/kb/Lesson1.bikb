	};
	
	class L3103
	{
		text="AT THE START, THE STRATEGIC OVERLAY IS MINIMIZED. LET�S START BY OPENING THE SELECTION-PANEL - CLICK ON THE LITTLE ARROW NEXT TO YOUR GROUP NAME.";
		speech[]={"\sound\L3103.ogg"};
		class Arguments {};
	};
	class L3104
	{
		text="THE UNFOLDED TREE-PANEL DISPLAYS YOUR UNITS NAMES AS WELL AS THEIR TEAMCOLORS, WEAPON AND SUPPORT ABILITIES.";
		speech[]={"\sound\L3104.ogg"};
		class Arguments {};
	};
	class L3105
	{
		text="CLICKING ON A UNIT NAME WILL SELECT THAT UNIT INDIVIDUALLY. IF YOU HAVE INDIVIDUAL UNITS SELECTED, YOU CAN RIGHT-CLICK ANYWHERE INTO THE BOX TO RE-CENTER THE MAP ON THAT UNIT�S POSITION. SELECT UNIT TWO AND CENTER THE MAP (RIGHT CLICK ON NAME/BOX).";
		speech[]={"\sound\L3105.ogg"};
		class Arguments {};
	};
	class L3106
	{
		text="YOU CAN USE THE STANDARD �CTRL + CLICK� AND �SHIFT + CLICK� TO SELECT MULTIPLE LIST ITEMS. SELECT UNIT-2 AND UNIT-3.";
		speech[]={"\sound\L3106.ogg"};
		class Arguments {};
	};
	class L3107
	{
		text="ONCE UNITS ARE SELECTED, SHIFT+RMB ANYWHERE INTO THE PANEL WILL OPEN THE TEAMCOLOR SELECTOR. ASSIGN UNITS 2 AND 3 TO TEAM RED.";
		speech[]={"\sound\L3107.ogg"};
		class Arguments {};
	};
	class L3108
	{
		text="THE TEAMCOLOR CONTROLS ABOVE THE SELECTION-TREE HAVE ADAPTED TO DISPLAY THE NEW CONFIGURATION.";
		speech[]={"\sound\L3108.ogg"};
		class Arguments {};
	};
	class L31081
	{
		text="SELECT ALL UNITS BY CLICKING ON THE PURPLE COLOR BAR ABOVE THE SELECTION PANEL.";
		speech[]={"\sound\L31081.ogg"};
		class Arguments {};
	};
	class L3109
	{
		text="VERY GOOD SERGEANT. YOU CAN ALSO SELECT UNITS BY CLICKING ON THEIR ICONS. SELECT UNIT-2 BY LEFT CLICKING ON IT�S MAP-ICON.";
		speech[]={"\sound\L3109.ogg"};
		class Arguments {};
	};
	
	class L31091
	{ 
		text="NOW ADD UNIT-4 TO THE SELECTION BY HOLDING DOWN CTRL AND LEFT-CLICKING ON IT'S UNIT-ICON";
		speech[]={"\sound\L31091.ogg"};
		class Arguments {};
	};
	
	class L3110
	{
		text="GOOD. YOU CAN DRAW A SELECTION FIELD BY HOLDING DOWN CTRL AND DRAGGING LMB TO DESIGNATE YOUR DESIRED AREA. ANY UNITS WITHIN THAT AREA WILL BE ADDED- OR REMOVED - FROM YOUR SELECTION. SELECT SOME UNITS BY DRAGGING A FIELD.";
		speech[]={"\sound\L3110.ogg"};
		class Arguments {};
	};
	class L3111
	{
		text="TIME TO PLACE A WAYPOINT. LEFT-CLICK ON YOUR DESIRED POSITION AND KEEP THE BUTTON PRESSED WHILE DRAGGING THE MOUSE OFF TO YOUR DESIRED LOOKING DIRECTION. VISION CONES CAN BE MODIFIED AFTERWARDS.";
		speech[]={"\sound\L3111.ogg"};
		class Arguments {};
	};
	class L3112
	{
		text="ON SQUAD LEVEL, YOU NEED TO CONFIRM YOUR PLANS BEFORE THEY ARE EXECUTED. 'COMMIT ALL' WILL EXECUTE ALL PLANS,  WHILE �COMMIT� WILL EXECUTE PLANS FOR THE CURRENT SELECTION. THE �COMMIT ALL� BEHAVIOUR CAN ALSO BE QUICK-SELECTED BY HITTING SPACE-BAR.";
		speech[]={"\sound\L3112.ogg"};
		class Arguments {};
	};
	class L3113
	{
		text="NOW SELECT UNIT-2 INDIVIDUALLY WITH YOUR PREFERRED METHOD.";
		speech[]={"\sound\L3113.ogg"};
		class Arguments {};
	};
	class L3114
	{
		text="YOU MAY HAVE NOTICED THE COMMAND-BAR UNFOLDING FROM THE MENU ONCE UNITS WERE SELECTED. THESE SETTINGS CONFIGURE THE PROPERTIES OF THE NEXT WAYPOINT THAT YOU PLACE.";
		speech[]={"\sound\L3114.ogg"};
		class Arguments {};
	};
	class L3115
	{
		text="YOU ARE ALREADY FAMILIAR WITH SOME OF THESE CONTROLS AS WELL. TRAVEL STANCE, SPEED AND ARRIVAL STANCE WORK EXACLTY AS THEY DO IN TACTICAL MODE.";
		speech[]={"\sound\L3115.ogg"};
		class Arguments {};
	};
	class L3116
	{
		text="COMBAT MODE HAS TWO SETTINGS, �ENGAGE� IS SIMPLY DEFAULT BEHAVIOUR, �DISENGAGE� IS  ALSO KNOWN AS �AT ALL COST�. KEEP IT ON �ENGAGE� FOR NOW.";
		speech[]={"\sound\L3116.ogg"};
		class Arguments {};
	};
	
	class L3117
	{
		text="THE WAYPOINT ACTIONS ARE AGAIN A KEY FACTOR OF THIS MENU. IT�S CONTENTS ARE DEPENDENT ON YOUR CURRENT SELECTION. OPEN THE ACTION-SELECTOR.";
		speech[]={"\sound\L3117.ogg"};
		class Arguments {};
	};
	
	class L3118
	{
		text="NOW SELECT �THROWABLES�, CHOSE YOUR DESIRED GRENADE-TYPE AND CLICK THE POSITION YOU WANT IT THROWN AT. MAX THROWING DISTANCE IS APPROXIMATELY 30M.";
		speech[]={"\sound\L3118.ogg"};
		class Arguments {};
	};
	
	class L3119
	{
		text="GREAT. NOW SELECT THE �SUPPRESS AREA� ACTION AND PLACE A WAYPOINT.";
		speech[]={"\sound\L3119.ogg"};
		class Arguments {};
	};
	
	class L31191
	{
		text="THE SUPPRESSION-ACTION SPAWNED A VISIBLE POLYGON AREA ON THE MAP";
		speech[]={"\sound\L31191.ogg"};
		class Arguments {};
	};
	
	class L31192
	{
		text="YOU CAN DRAG AROUND THE EDGES OF THE POLYGON FOR ADJUSTMENT, AND YOU CAN MOVE IT AROUND BY DRAGGING IT'S CENTER MARKER WITH LEFT-MOUSE-BUTTON";
		speech[]={"\sound\L31192.ogg"};
		class Arguments {};
	};
	
	class L31193
	{
		text="IF YOU DRAG THE CENTER-MARK WHILE HOLDING 'CTRL', YOU WILL ADJUST THE TOTAL SIZE OF THE POLYGON. FINALLY YOU CAN ROTATE THE POLYGON BY HOLDING DOWN 'ALT' AS YOU DRAG THE CENTER-ICON.";
		speech[]={"\sound\L31193.ogg"};
		class Arguments {};
	};
	
	class L3120
	{
		text="DID YOU SPOT THE �GO� BUTTON CHANGE TO �D�? THAT�S BECAUSE WE NEED  AN EXIT CONDITION TO KNOW WHEN TO STOP SUPPRESSION. CONDITIONS ARE A POWERFUL TOOL FOR WAYPOINT PLANS.";
		speech[]={"\sound\L3120.ogg"};
		class Arguments {};
	};
	class L31202
	{
		text="OPEN THE CONDITION SELECTION";
		speech[]={"\sound\L31202.ogg"};
		class Arguments {};
	};
	class L31201
	{
		text="HERE WE HAVE ACCESS TO THE TIMEOUT AND GO-CODE TYPE. TIMEOUT WILL MAKE THE UNIT WAIT FOR X-SECONDS BEFORE CONTINUING TO THE NEXT WAYPOINT. GOCODES WILL MAKE THE UNITS WAIT  UNTIL YOU MANUALLY ACTIVATE THE GOCODE. THE SUPPRESSION ACTION WILL SELECT GOCODE �D� BY DEFAULT IF NO CONDITION WAS SPECIFIED.";
		speech[]={"\sound\L31201.ogg"};
		class Arguments {};
	};
	
	class L3121
	{
		text="SELECT ANY CONDITION OTHER THAN 'GO' AND PLACE ANOTHER WAYPOINT.";
		speech[]={"\sound\L3121.ogg"};
		class Arguments {};
	};
	class L31211
	{
		text="NOW RESET THE CONDITION TO 'GO', WHICH MEANS 'NO CONDITION'";
		speech[]={"\sound\L31211.ogg"};
		class Arguments {};
	};
	
	class L31212
	{
		text="PLACE ONE FINAL WAYPOINT";
		speech[]={"\sound\L31212.ogg"}; //
		class Arguments {};
	};
	
	class L31213
	{
		text="NOW COMMIT TO YOUR PLAN";
		speech[]={"\sound\L31213.ogg"}; //
		class Arguments {};
	};
	
	class L31214
	{
		text="stand by";
		speech[]={"\sound\L31214.ogg"};
		class Arguments {};
	};
	
	class L3123
	{
		text="THE UNIT STARTED SUPPRESSING. NOW WE NEED TO ACTIVATE GOCODE-D TO STOP HIM. THE MAP�S GOCODE CONTROLS ARE LOCATED IN THE TOP RIGHT OF THE MAP FRAME.";
		speech[]={"\sound\L3123.ogg"};
		class Arguments {};
	};
	
	class L3124
	{
		text="GOOD. THE UNIT STOPPED SUPPRESSING AND NOW MOVES TO THE NEXT WAYPOINT. WAIT FOR THE TIME OUT OR TOGGLE THE GO-CODE IF NEEDED";
		speech[]={"\sound\L3124.ogg"};
		class Arguments {};
	};
	
	class L3125
	{
		text="WE HAVE TO KEEP IT BRIEF SERGEANT, BUT THERE�S SOME LESS INTUITIVE FUNCTIONS THAT WE WILL GET FAMILIAR WITH.";
		speech[]={"\sound\L3125.ogg"};
		class Arguments {};
	};
	
	class L3126
	{
		text="FORMATIONS FOR MULTIPLE UNITS ARE POWERFUL, BUT LESS INTUITIVE. THEY COMBINE FORMATION AND ORIENTATION AT THE SAME TIME.";
		speech[]={"\sound\L3126.ogg"};
		class Arguments {};
	};
	
	
	class L3127
	{
		text="PLACE A WAYPOINT AND DRAG THE LOOKING DIRECTION TO THE NORTH. BY DEFAULT, THE UNITS WILL BE FORM UP A LINE BEHIND THE FIRST UNIT, FORMING A 180 DEGREE FIRING SECTOR.";
		speech[]={"\sound\L3127.ogg"};
		class Arguments {};
	};
	
	class L31271
	{
		text="PLEASE OPEN THE FORMATION SELECTION.";
		speech[]={"\sound\L31271.ogg"};
		class Arguments {};
	};
	
	
	class L3128
	{
		text="NOW SELECT THE SECOND SETTING ( + 90 DEG) AND PLACE ANOTHER WAYPOINT, ALSO  WITH A LOOKING DIRECTION TO THE NORTH. THIS TIME UNITS WILL STACK UP TOWARDS THE RIGHT/EAST.";
		speech[]={"\sound\L3128.ogg"};
		class Arguments {};
	};
	
	class L3129
	{
		text="THE LEFT VARIANT WORKS CORRESPONDINGLY. SELECT THE �CIRCLE� FORMATION NOW.";
		speech[]={"\sound\L3129.ogg"};
		class Arguments {};
	};
	
	class L3130
	{
		text="CIRCLE FORMATION DOES NOT REQUIRE ORIENTATION, IN THIS CASE YOUR MOUSE-DRAG WILL DETERMINE THE CIRCLE-RADIUS. PLACE A WAYPOINT WITH CIRCLE FORMATION";
		speech[]={"\sound\L3130.ogg"};
		class Arguments {};
	};
	
	
	class L31301
	{
		text="LET'S LOOK AT SOME WAYS TO REMOVE WAYPOINTS. FIRST, YOU CAN USE THE 'UNDO' FUCTION. USE IT TO REMOVE YOUR LAST ACTION.";
		speech[]={"\sound\L31301.ogg"}; //
		class Arguments {};
	};
	
	class L31302
	{
		text="next, RIGHT-CLICK ON ONE OF THE WAYPOINTS AND USE THE TRASHCAN ACTION";
		speech[]={"\sound\L31302.ogg"}; //
		class Arguments {};
	};
	
	class L31303
	{
		text="FINALLY, THERE'S THE DELETE BUTTON. REFER TO THE TOOLTIP FOR DETAILS AND USE A SIMPLE CLICK TO REMOVE THE CURRENT PLANNING STAGE";
		speech[]={"\sound\L31303.ogg"}; //
		class Arguments {};
	};
	
	class L3131
	{
		text="LAST BUT NOT LEAST, SPLIT FORMATION IS A VERY USEFUL MECHANIC ONCE UNDERSTOOD. IN THIS FORMATION, YOU WILL PLACE DOWN INDIVIDUAL WAYPOINTS, CYCLING THROUGH YOUR UNIT SELECTION ONE BY ONE. THESE WAYPOINTS ARE SYNCHRONIZED AUTOMATICALLY, SO YOU CAN USE IT TO QUICKLY MOVE FIRETEAMS FROM COVER TO COVER. OPEN THE FORMATION SELECTION AND SELECT �SPLIT FORMATION�.";
		speech[]={"\sound\L3131.ogg"};
		class Arguments {};
	};
	
	class L3132
	{
		text="PLACE TWO WAYPOINTS PER UNIT - 8 WAYPOINTS TOTAL - THE UNITS ARE TARGETED AUTOMATICALLY. ";
		speech[]={"\sound\L3132.ogg"};
		class Arguments {};
	};
	
	
	
	
	class L3133
	{
		text="NOW COMMIT AND OBSERVE THE BEHAVIOUR.";
		speech[]={"\sound\L3133.ogg"};
		class Arguments {};
	};
	
	class L3134
	{
		text="YOU CAN USE THE �HOLD/CONTINUE� FUNCTION TO INTERRUPT YOUR PLANS UNTIL YOU WANT TO CONTINUE.";
		speech[]={"\sound\L3134.ogg"};
		class Arguments {};
	};
	class L31341
	{
		text="TOO SLOW SERGEANT - PLACE A FEW WAYPOINTS AND COMMIT. OCCUPY THE UNIT A LITTLE BY LEAVING  SOME SPACE BETWEEN WAYPOINTS";
		speech[]={"\sound\L31341.ogg"}; //
		class Arguments {};
	};
	class L3135
	{
		text="PUT ALL UNITS INTO �HOLD� STATE BY CLICKING THE PAUSE BUTTON.";
		speech[]={"\sound\L3135.ogg"};
		class Arguments {};
	};
	
	class L3136
	{
		text="OBSERVE HOW THE UNITS WILL TAKE CONVER. THE HOLD STATE IS REPRESENTED BY LOWER OPACITIES FOR THE UNIT�S MAP ICONS.";
		speech[]={"\sound\L3136.ogg"};
		class Arguments {};
	};
	
	class L3137
	{
		text="WHEN YOU ARE READY TO CONTINUE, CLICK ON THE PLAY BUTTON TO MAKE SELECTED UNITS CONTINUE THEIR PLANS.";
		speech[]={"\sound\L3137.ogg"};
		class Arguments {};
	};
	
	
	class L31371
	{
		text="YOU CAN USE THE FORCE TRACKER TO ASSIGN TARGETS TO YOUR COMMANDED UNITS. RIGHT CLICK ON THE ENEMY ICON AND SELECT �ATTACK� TO ASSIGN THE TARGET TO YOUR SELECTED UNITS.";
		speech[]={"\sound\L31371.ogg"};
