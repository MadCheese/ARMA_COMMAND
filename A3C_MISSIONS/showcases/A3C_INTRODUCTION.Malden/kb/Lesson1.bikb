	};
	class LSMHC23
	{
		text="NOTE THAT CERTAIN ACTIONS SUCH AS �FIRE SUPPORT� REQUIRE EXIT CONDITIONS THEMSELVES. THESE ARE SEPERATED FROM THE ABOVE �COMPLETION� IN ORDER TO GIVE YOU MORE PLANNING FLEXIBILITY. ";
		speech[]={"\sound\LSMHC23.ogg"};
