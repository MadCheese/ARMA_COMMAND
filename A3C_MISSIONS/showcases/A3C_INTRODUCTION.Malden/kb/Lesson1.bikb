	class L2_RAD_INTRO_1
	{
		text="WELCOME BACK SERGEANT. IN THIS LESSON WE WILL LEARN HOW TO USE THE RADIAL MENU. LET'S TAKE A LOOK AT THE MENU BEFORE WE START - OPEN IT AND MAKE SURE TO KEEP YOUR MENU KEY PRESSED DOWN!";
		speech[]={"\sound\L2_RAD_INTRO_1.ogg"};
		class Arguments {};
	};
	
	class L2_RAD_INTRO_2
	{
		text="THE RADIAL PROVIDES QUICK ACCESS TO A LARGE RANGE OF ACTIONS AND ESSENTIAL SETTINGS. HOVERING OVER A SECTION TOGGLES IT'S SELECTION - CLICK ON SECTION TO DISABLE HOVERING. TAKE A LOOK AROUND AND CLOSE THE MENU WHEN YOU'RE READY TO START THE LESSON. ";
		speech[]={"\sound\L2_RAD_INTRO_2.ogg"};
		class Arguments {};
	};

	
