	};
	class LSMHC17
	{
		text="LET�S LOOK AT WAYPOINT COMPLETION. THE CONDITION SET HERE HAS TO BE FULFILLED BEFORE PROGRESSING TO THE NEXT WAYPOINT OR ACTION. CLICK ON  �ARRIVAL� TO OPEN THE SELECTION.";
		speech[]={"\sound\LSMHC17.ogg"};
