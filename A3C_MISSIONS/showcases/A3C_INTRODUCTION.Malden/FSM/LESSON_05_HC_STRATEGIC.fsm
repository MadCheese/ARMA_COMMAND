                         "			sleep 0.2;" \n
                         "			_img ctrlShow false;" \n
                         "			(findDisplay _IDD_MAP_OVERLAY displayCtrl _IDC_MAP_HCWP_Type_Action) lbSetColor [_lbIndex, [1,1,1,1]];" \n
                         "			sleep 0.2;" \n
