                         "" \n
                         "END_LESSON = false;" \n
                         "" \n
                         "{_x setUnitPos ""MIDDLE""} foreach (units gp1);" \n
                         "" \n
                         "setdate [2020,8,13,5,18];  0 setOvercast 0.6; 0 setRain 0; 0 setfog [0.28,0.021,-78];  setwind [0,0,true]; forceWeatherChange;  999999 setRain 0;" \n
                         "" \n
                         "" \n
                         "" \n
                         "r4 removeweapon ""launch_MRAWS_sand_F"";" \n
                         "r4 addweapon ""launch_MRAWS_sand_F"";" \n
                         "r4 addSecondaryWeaponItem ""MRAWS_HEAT_F"";" \n
                         "" \n
                         "(units gp1) joinSilent group player;" \n
                         "[] call full_teamcolors;" \n
                         "deleteGroup gp1;" \n
                         "[] spawn {" \n
                         "	sleep 2; " \n
                         "	{_x setUnitPos ""MIDDLE""} foreach (units player);" \n
