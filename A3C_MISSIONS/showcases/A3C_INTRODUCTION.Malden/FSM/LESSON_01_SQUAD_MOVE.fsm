                         "" \n
                         "[] call lesson_selector;" \n
                         "" \n
                         "{" \n
                         "	if (vehicle _x isKindOf ""STATICWEAPON"") then {" \n
                         "		deletevehicle (vehicle _x);	" \n
                         "	};" \n
                         "	[[_x],true,false] call A3C_ai_shared_fnc_cancelUnitPlot;" \n
                         "	_x setUnitPos ""AUTO"";" \n
                         "} foreach _units;" \n
                         "" \n
                         "gp1 = creategroup resistance;" \n
                         "[r1,r2,r3,r4] joinSilent gp1;" \n
                         "" \n
                         "gp2 = creategroup resistance;" \n
                         "[g1,g2,g3,g4] joinSilent gp2;" \n
                         "" \n
                         "{" \n
                         "	{" \n
                         "		[_x] call restore_loadout" \n
                         "	} foreach units _x;" \n
                         "} foreach [gp1,gp2];" \n
                         "" \n
                         "[] call init_position;" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
