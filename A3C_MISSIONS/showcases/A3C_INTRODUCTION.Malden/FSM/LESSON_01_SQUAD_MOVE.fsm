class FSM
{
        fsmName = "LESSON_HUD";
        class States
        {
                /*%FSM<STATE "ASSIGN__select_UNIT">*/
                class ASSIGN__select_UNIT
                {
                        name = "ASSIGN__select_UNIT";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"//-- Assign Task: Select UNIT 2" \n
                         "_fncBind = [""A3C_KeyFnc_Hud_Unit_02""] call MCSS_C2TUT_getCBABind;" \n
                         "_hintStr = format [""Select only UNIT-2 in TACTICAL MODE (Press %1)"",_fncBind];" \n
                         "" \n
                         "((uiNamespace getVariable ""TutorialHint"") displayCtrl 50001) ctrlSetText _hintStr;" \n
                         "((uiNamespace getVariable ""TutorialHint"") displayCtrl 50002) ctrlSetText ""#(argb,8,8,3)color(0,0,0,0.9)"";" \n
                         "" \n
                         "" \n
                         "o1 kbTell [p1, ""Lesson1"", ""Ll_HUD_SEL_IND""];" \n
                         "" \n
                         "o1 domove [8216.17,10261.3,0];" \n
                         "_timer = time;" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "UNIT2__selected">*/
                                class UNIT2__selected
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="Assign__Rotate";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"A3C_UI_squadPlacement_units isEqualTo [units player select 1] OR WIP_SKIP &&" \n
                                         "{" \n
                                         "	o1 kbWasSaid [p1, ""Lesson1"", ""Ll_HUD_SEL_IND"",99999999999]" \n
                                         "}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Start_">*/
                class Start_
                {
                        name = "Start_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_timer = time;" \n
                         "titlecut [""TACTICAL MODE"",""black faded"",0];" \n
                         "(units gp1) joinSilent group player;" \n
                         "(units gp2) joinSilent group player;" \n
                         "" \n
                         "[] call full_teamcolors;" \n
                         "[(units group player) - [player]] call A3C_ui_shared_fnc_resetPlayerGroup;" \n
                         "" \n
                         "{deleteGroup _x} foreach [gp1,gp2];" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "true___">*/
                                class true___
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"alive player && time > _timer + 4" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Assign__Select_A">*/
                class Assign__Select_A
                {
                        name = "Assign__Select_A";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/"AskPlayerToContinue = false; //-- for loop" \n
                         "TUTORIAL_CONTINUE = 0;" \n
                         "" \n
                         "//-- Assign Task: Select All Units In HUD" \n
                         "_fncBind = [""A3C_KeyFnc_Hud_TeamSel_ALL""] call MCSS_C2TUT_getCBABind;" \n
                         "_hintStr = format [""Select all units in TACTICAL MODE (Press %1)"",_fncBind];" \n
                         "" \n
                         "((uiNamespace getVariable ""TutorialHint"") displayCtrl 50001) ctrlSetText _hintStr;" \n
                         "" \n
                         "//-- create the necessary situation for exercise" \n
                         "{[_x] call A3C_UI_squadPlacement_fnc_removeUnitGhost} foreach A3C_UI_squadPlacement_units;" \n
                         "" \n
                         "[""Ll_HUD_SEL_ALL""] call fnc_interrupt;" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "[] call reset_hudImage;" \n
                         "" \n
                         "" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "all_units_selected">*/
                                class all_units_selected
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Assign__change_s";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(count A3C_UI_squadPlacement_units) == (count (units group player - [player])) "/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "wait">*/
                class wait
                {
                        name = "wait";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_time = time;" \n
                         "_scr = [[8195.75,10280.5,0.00144005], 160,units player - [player],""BWD"", false,[[8207.1,10261.9,0.00144768],348.136],[2020,8,13,3,16]] spawn NEW_LOCATION;" \n
                         "" \n
                         "" \n
                         "" \n
                         "//o1 setpos [8207.21,10265.2,0.00143242]; " \n
                         "//o1 setdir 186; " \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "wait___">*/
                                class wait___
                                {
                                        itemno = 40;
                                        priority = 0.000000;
                                        to="wait_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"scriptdone _scr" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
