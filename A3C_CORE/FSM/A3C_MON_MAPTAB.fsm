*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "A3C_MON_MAPTAB";
        class States
        {
                /*%FSM<STATE "Start_">*/
                class Start_
                {
                        name = "Start_";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private _dspID = _this select 0;" \n
                         "private _originalHud = _this select 1;" \n
                         "private _dsp = findDisplay _dspID;" \n
                         "" \n
                         "//systemchat str [""FSM"",_dspID];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "TRUE___">*/
                                class TRUE___
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="LOOP_INIT";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Exit_">*/
                class Exit_
                {
                        name = "Exit_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"showHud _originalHUD;" \n
                         "" \n
                         "//systemchat ""fsm closed"";" \n
                         "" \n
                         "" \n
                         "A3C_SELECTED_UNITS = [];" \n
                         "" \n
                         "" \n
                         "//---------------------------- Loop completed: Tablet is closed -------------------------------" \n
                         "//----------------------------------------------------------------------------------------" \n
                         "if (A3C_HC_GroupMenu_SuppressionRequested) then {" \n
                         "	systemchat ""A3C: Suppression request cancelled - map and\or overlay closed"";" \n
                         "	A3C_HC_GroupMenu_SuppressionRequested = false;" \n
                         "	[""A3C_SUP_MAPCLICK"", ""onMapSingleClick""] call BIS_fnc_removeStackedEventHandler;" \n
                         "};" \n
                         "" \n
                         "" \n
                         "//-- just for safety: activate map" \n
                         "(findDisplay 12 displayCtrl 51) ctrlEnable true;" \n
                         "" \n
                         "//-- re-activate Action-Menu" \n
                         "{inGameUISetEventHandler [_x, ""false""]} foreach [""PrevAction"",""NextAction""];" \n
                         "" \n
                         "//-- switch back to regular groupBar/commandBar when HC was used" \n
                         "if (hcShownBar) then {hcShowBar false};" \n
                         "" \n
                         "" \n
                         "//-- reset variables, remove UI eventhandlers (unnecessary?), delete tablet markers." \n
                         "A3C_USERACTION = [];" \n
                         "A3C_PICKUP_OBJECTS = []; //-- security for player not completing Sling Action (probably only relevant for HC)" \n
                         "//A3C_SELECTED_UNITS = [];" \n
                         "A3C_WAYPOINTS_TEMP =[];" \n
                         "A3C_DIAG_ACTIVE = false;" \n
                         "A3C_TAB_BUILDING_BOOL = false;" \n
                         "A3C_MAP_BOOL_CT_EDIT_ACTIVE = false;" \n
                         "A3C_BOOL_DISABLEMAPCTRL = false;" \n
                         "A3C_BOOL_MOUSEMOVING = false;" \n
                         "A3C_BOOL_MAPFORCE = true;" \n
                         "" \n
                         "//player removeEventHandler [""killed"", A3C_KILLED_WIP];" \n
                         "{deletemarkerLocal _x;} foreach A3C_TRACKER_MARKERS; // (A3C_TAB_MARKERS + A3C_TRACKER_MARKERS);" \n
                         "if !((getmarkercolor ""A3C_BUILDING_VIEWER"") == """") then {deletemarkerLocal ""A3C_BUILDING_VIEWER""};" \n
                         "" \n
                         "" \n
                         "(findDisplay 12 displayCtrl 51) ctrlEnable true;" \n
                         "findDisplay 12 displayCtrl 51 ctrlMapCursor [""Track"", ""Track""];" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "//_opac = 1;" \n
                         "//_hide = false;" \n
                         "//if (difficulty > 1) then {" \n
                         "//	_hide = true;" \n
                         "//};" \n
                         "" \n
                         "//if (_hide) then {" \n
                         "//	_opac = 0;" \n
                         "//};" \n
                         "" \n
                         "//-- what was this next bit??" \n
                         "//mouseOverIcon = (missionNamespace getVariable ""AIC_Interactive_Icon_Over_Icon"");" \n
                         "//if (!isNil ""_mouseOverIcon"") then {_opac = 1};" \n
                         "" \n
                         "//A3C_OPACITY = _opac;" \n
                         "//systemchat str _opac;" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "LOOP_INIT">*/
                class LOOP_INIT
                {
                        name = "LOOP_INIT";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"_timer = time;" \n
                         "//systemchat 'fsm loop';"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "MAP__map_was_clo">*/
                                class MAP__map_was_clo
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="close_overlay";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_dspID == 6998 && {!visibleMap}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "SLEEP">*/
                                class SLEEP
                                {
                                        itemno = 7;
                                        priority = 0.000000;
                                        to="CHECK_DEAD";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _timer + 2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "DISPLAY_CLOSED">*/
                                class DISPLAY_CLOSED
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNull (findDisplay _dspID)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "close_overlay">*/
                class close_overlay
                {
                        name = "close_overlay";
                        itemno = 6;
                        init = /*%FSM<STATEINIT""">*/"[6998] call A3C_MAP_UI_FNC_CloseMapOverlay;" \n
                         "//systemchat 'fsm hide';"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "DISPLAY_CLOSED">*/
                                class DISPLAY_CLOSED
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNull (findDisplay _dspID)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "CHECK_DEAD">*/
                class CHECK_DEAD
                {
                        name = "CHECK_DEAD";
                        itemno = 9;
                        init = /*%FSM<STATEINIT""">*/"//[] call A3C_CHECK_FOR_DEAD_WIP;" \n
                         "[] call A3C_MAP_UI_UnitTree_Sync;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "EMPTY">*/
                                class EMPTY
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="LOOP_INIT";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="Start_";
        finalStates[] =
        {
                "Exit_",
        };
};
/*%FSM</COMPILE>*/