                {
                        name = "Exit_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//systemchat 'exit radial fsm';"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "LOOP_INIT">*/
                class LOOP_INIT
                {
                        name = "LOOP_INIT";
                        itemno = 4;
                        init = /*%FSM<STATEINIT""">*/"_timer = time;" \n
                         "//systemchat 'fsm loop';"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "CTRLSGROUP_HIDDE">*/
                                class CTRLSGROUP_HIDDE
                                {
                                        itemno = 5;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(ctrlShown _ctrlsGroup)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "SLEEP">*/
                                class SLEEP
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="CHECK_DEAD";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _timer + 2"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "DISPLAY_CLOSED">*/
                                class DISPLAY_CLOSED
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNull _dsp"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
