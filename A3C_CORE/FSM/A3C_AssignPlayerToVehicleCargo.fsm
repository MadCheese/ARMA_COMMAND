                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(_chopper getvariable ""A3C_CHOPPER_ASSG_ACTIVE"") OR !(canmove _chopper) or !(alive (driver _chopper))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
