                         "_unit = _this select 1;" \n
                         "_switchVar = 0;" \n
                         "" \n
                         "_chopper setvariable [""A3C_CHOPPER_ASSG_ACTIVE"",true,true];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Dialog_active_">*/
                                class Dialog_active_
                                {
                                        itemno = 1;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_chopper getvariable ""A3C_CHOPPER_ASSG_ACTIVE"""/*%FSM</CONDITION""">*/;
