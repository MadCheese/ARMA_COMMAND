                        name = "Exit_";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_chopper setvariable [""A3C_CHOPPER_ASSG_ACTIVE"",false,true];" \n
                         "player removeAction A3C_assign_action_playerToVehicle;" \n
                         ""/*%FSM</STATEINIT""">*/;
