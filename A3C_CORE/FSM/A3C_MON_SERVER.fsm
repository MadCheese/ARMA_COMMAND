*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "A3C_MON_SERVER";
        class States
        {
                /*%FSM<STATE "Start_">*/
                class Start_
                {
                        name = "Start_";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "" \n
                         "" \n
                         "" \n
                         "_time1 = time;" \n
                         "_time2 = time;" \n
                         "_time3 = time;" \n
                         "_time4 = time;" \n
                         "" \n
                         "private _slingEvents = [];" \n
                         "" \n
                         "A3C_TCL_GROUPS = [];" \n
                         "//if (!isServer) exitWith {};" \n
                         "" \n
                         "_exitCondition = if (isServer) then {[] call {A3C_MISSIONENDED}} else {(isnull (finddisplay 46))};" \n
                         "" \n
                         "A3C_Mon_Server_EH_units = [];" \n
                         "publicVariable 'A3C_Mon_Server_EH_units';" \n
                         "" \n
                         "" \n
                         "" \n
                         "private _sides = [];" \n
                         "" \n
                         "" \n
                         "" \n
                         "A3C_exitServerMon = false;" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "start_conditions">*/
                                class start_conditions
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true && {!(is3DEN)} && {time > (_time2 + 1)}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Exit_">*/
                class Exit_
                {
                        name = "Exit_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "diag_log ""[A3C]: exit servermon"";" \n
                         """FSM SERVER MON EXIT"" remoteExec [""systemchat"",0];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "NEW_CYCLE">*/
                class NEW_CYCLE
                {
                        name = "NEW_CYCLE";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_sides = [];" \n
                         "" \n
                         "" \n
                         "// (format [""SERVER MON LOOP RUNNING ON: %1"", clientOwner]) remoteExec ['systemchat',0];" \n
                         "" \n
                         "//-- TCL == TACTICAL COMBAT LINK" \n
                         "{" \n
                         "	if (count units _x == 0) then {" \n
                         "		A3C_TCL_GROUPS = A3C_TCL_GROUPS - [_x];" \n
                         "		deleteGroup _x;" \n
                         "	};" \n
                         "} foreach A3C_TCL_GROUPS;" \n
                         "" \n
                         "_playerClientIDs = [0,2];" \n
                         "{" \n
                         "	private _player = _x;" \n
                         "	private _playerUID = getPlayerUID _player;" \n
                         "	_sides pushBackUnique (side _player);" \n
                         "	//" \n
                         "	if (isServer) then {" \n
                         "		if (_playerUID in A3C_CLIENT_IDS) then {" \n
                         "			_playerClientIDs pushBackUnique (owner _player)" \n
                         "		};" \n
                         "	};" \n
                         "} foreach allPlayers;" \n
                         "" \n
                         "_A3C_MON_SERVER_checkGroups = [];" \n
                         "" \n
                         "if (isServer) then {" \n
                         "	{" \n
                         "		private _group = _x;" \n
                         "		private _groupSide = side _group;" \n
                         "		private _leader = leader _group;" \n
                         "" \n
                         "		if (" \n
                         "			!isNull _leader" \n
                         "			&& {{_x getFriend _groupSide < 0.6} count _sides == 0}" \n
                         "			&& {(owner _leader) in _playerClientIDs}" \n
                         "		) then {" \n
                         "			_A3C_MON_SERVER_checkGroups pushBackUnique _group;" \n
                         "		};" \n
                         "	} forEach (" \n
                         "		(allGroups) select {" \n
                         "			side _x != civilian" \n
                         "		}" \n
                         "	);" \n
                         "	A3C_MON_SERVER_checkGroups = _A3C_MON_SERVER_checkGroups;" \n
                         "	publicVariable'A3C_MON_SERVER_checkGroups';" \n
                         "} else {" \n
                         "	//-- client on server without A3C - only allow reserve that is local to client #UNCLEAR: WOULD THIS EVER RUN???" \n
                         "	{" \n
                         "		if ((side _x in _sides) ) then { //&& {local (leader _x)} ////isPlayer leader _x" \n
                         "			_A3C_MON_SERVER_checkGroups pushBackUnique _x;			" \n
                         "		};" \n
                         "	} foreach ((allGroups) select {side _x != civilian});" \n
                         "	A3C_MON_SERVER_checkGroups = _A3C_MON_SERVER_checkGroups;	" \n
                         "};"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "wait_10s_">*/
                                class wait_10s_
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="HC_ACTIONS__relay";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > (_time2 + 10 + (0.5 * (count allPlayers))) //-- adjust sleep time because of the knowsabout requests"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "secondary_s_out">*/
                                class secondary_s_out
                                {
                                        itemno = 12;
                                        priority = 0.000000;
                                        to="MISSILE__TARGET";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time1 + 1 //isServer && {};" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_2s_">*/
                                class wait_2s_
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="WP_RADIUS";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > _time3 + 2 )"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_5s_">*/
                                class wait_5s_
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="STATE__1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > _time4 + 5 ) "/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "STATE_">*/
                class STATE_
                {
                        name = "STATE_";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"_time4 = time;" \n
                         "" \n
                         "//systemchat ""state"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "HC_ACTIONS__relay">*/
                class HC_ACTIONS__relay
                {
                        name = "HC_ACTIONS__relay";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "[] spawn A3C_server_fnc_serverMonitorMain; //-- spawn instead of call because we need to wait for client results" \n
                         "" \n
                         "_time2 = time;" \n
                         "" \n
                         "//-- make all groups ready their launchers for RHS" \n
                         "{" \n
                         "	private _leader = leader _x;" \n
                         "" \n
                         "	if (!isNull _leader) then {" \n
                         "		[[_x], A3C_ai_shared_fnc_readyLaunchers] remoteExec [" \n
                         "			""bis_fnc_call""," \n
                         "			_leader" \n
                         "		];" \n
                         "	};" \n
                         "} forEach A3C_MON_SERVER_checkGroups;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "MISSILE__TARGET">*/
                class MISSILE__TARGET
                {
                        name = "MISSILE__TARGET";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "" \n
                         "" \n
                         "" \n
                         "//systemchat ""LAUNCHER"";" \n
                         "_assignedTargets = [];" \n
                         "{" \n
                         "	(_x getVariable [""A3C_Mon_Server_Var"",[-1,objNull,'']]) params [""_handle"",""_target"",""_ammo""];" \n
                         "	private _removeUnit = true;" \n
                         "	if (!isNull _target) then {	" \n
                         "		if (alive _target) then {" \n
                         "				_assignedTargets pushBack _target;" \n
                         "				_removeUnit = false;	" \n
                         "		};" \n
                         "	};" \n
                         "	if (_removeUnit) then {" \n
                         "		_x removeEventhandler [""FIRED"",_handle];" \n
                         "		A3C_Mon_Server_EH_units = A3C_Mon_Server_EH_units - [_x];" \n
                         "		publicVariable 'A3C_Mon_Server_EH_units';" \n
                         "	};			" \n
                         "} foreach A3C_Mon_Server_EH_units;" \n
                         "{" \n
                         "	_gp = _x;" \n
                         "	[_gp,_sides,_assignedTargets] call A3C_server_fnc_distributeMissileTargets;" \n
                         "} foreach A3C_MON_SERVER_checkGroups;" \n
                         "" \n
                         "_time1 = time;	" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "WP_RADIUS">*/
                class WP_RADIUS
                {
                        name = "WP_RADIUS";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"_slingEvents = [_slingEvents] call A3C_server_fnc_serverMonitorRadius;" \n
                         "" \n
                         "_time3 = time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "STATE__1">*/
                class STATE__1
                {
                        name = "STATE__1";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/"_exitCondition = if (isServer) then {[] call {A3C_MISSIONENDED}} else {(isnull (finddisplay 46))};" \n
                         "" \n
                         "//systemchat ""GAME RUNNING CHECK"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "game_running___">*/
                                class game_running___
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="STATE_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(_exitCondition)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "game_quit___">*/
                                class game_quit___
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"_exitCondition OR A3C_exitServerMon"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
        };
        initState="Start_";
        finalStates[] =
        {
                "Exit_",
        };
};
/*%FSM</COMPILE>*/