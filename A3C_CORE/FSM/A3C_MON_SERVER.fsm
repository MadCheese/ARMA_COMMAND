*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "A3C_MON_SERVER";
        class States
        {
                /*%FSM<STATE "Start_">*/
                class Start_
                {
                        name = "Start_";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "" \n
                         "" \n
                         "" \n
                         "_time1 = time;" \n
                         "_time2 = time;" \n
                         "_time3 = time;" \n
                         "_time4 = time;" \n
                         "" \n
                         "_slingEvents = [];" \n
                         "" \n
                         "A3C_TCL_GROUPS = [];" \n
                         "//if (!isServer) exitWith {};" \n
                         "" \n
                         "_exitCondition = if (isServer) then {[] call {A3C_MISSIONENDED}} else {(isnull (finddisplay 46))};" \n
                         "" \n
                         "A3C_Mon_Server_EH_units = [];" \n
                         "publicVariable 'A3C_Mon_Server_EH_units';" \n
                         "" \n
                         "" \n
                         "" \n
                         "private _sides = [];" \n
                         "" \n
                         "" \n
                         "" \n
                         "A3C_exitServerMon = false;" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "start_conditions">*/
                                class start_conditions
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true && {!(is3DEN)} && {time > (_time2 + 1)}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Exit_">*/
                class Exit_
                {
                        name = "Exit_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//diag_log format [""server_mon exit, condition: %1"",_exitCondition];" \n
                         "diag_log ""exit servermon"";" \n
                         """FSM SERVER MON EXIT"" remoteExec [""systemchat"",0];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "NEW_CYCLE">*/
                class NEW_CYCLE
                {
                        name = "NEW_CYCLE";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"_sides = [];" \n
                         "" \n
                         "" \n
                         "// (format [""SERVER MON LOOP RUNNING ON: %1"", clientOwner]) remoteExec ['systemchat',0];" \n
                         "" \n
                         "//-- TCL == TACTICAL COMBAT LINK" \n
                         "{" \n
                         "	if (count units _x == 0) then {" \n
                         "		A3C_TCL_GROUPS = A3C_TCL_GROUPS - [_x];" \n
                         "		deleteGroup _x;" \n
                         "	};" \n
                         "} foreach A3C_TCL_GROUPS;" \n
                         "" \n
                         "_playerClientIDs = [0,2];" \n
                         "{" \n
                         "	private _player = _x;" \n
                         "	private _playerUID = getPlayerUID _player;" \n
                         "	_sides pushBackUnique (side _player);" \n
                         "	//" \n
                         "	if (isServer) then {" \n
                         "		if (_playerUID in A3C_CLIENT_IDS) then {" \n
                         "			_playerClientIDs pushBackUnique (owner _player)" \n
                         "		};" \n
                         "	};" \n
                         "} foreach allPlayers;" \n
                         "" \n
                         "_A3C_MON_SERVER_checkGroups = [];" \n
                         "" \n
                         "if (isServer) then {" \n
                         "	{" \n
                         "		_groupSide = side _x;" \n
                         "		//if ((side _x in _sides) && {(owner (leader _x)) in _playerClientIDs}) then { //isPlayer leader _x" \n
                         "		if (({_x getFriend _groupSide < 0.6} count _sides == 0) && {(owner (leader _x)) in _playerClientIDs}) then { " \n
                         "			_A3C_MON_SERVER_checkGroups pushBackUnique _x;			" \n
                         "		};" \n
                         "	} foreach allGroups;" \n
                         "	A3C_MON_SERVER_checkGroups = _A3C_MON_SERVER_checkGroups;" \n
                         "	publicVariable'A3C_MON_SERVER_checkGroups';" \n
                         "} else {" \n
                         "	//-- client on server without A3C - only allow reserve that is local to client" \n
                         "	{" \n
                         "		if ((side _x in _sides) ) then { //&& {local (leader _x)} ////isPlayer leader _x" \n
                         "			_A3C_MON_SERVER_checkGroups pushBackUnique _x;			" \n
                         "		};" \n
                         "	} foreach allGroups;" \n
                         "	A3C_MON_SERVER_checkGroups = _A3C_MON_SERVER_checkGroups;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "wait_10s_">*/
                                class wait_10s_
                                {
                                        itemno = 9;
                                        priority = 0.000000;
                                        to="HC_ACTIONS__relay";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > (_time2 + 10 + (0.5 * (count allPlayers))) //-- adjust sleep time because of the knowsabout requests"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "secondary_s_out">*/
                                class secondary_s_out
                                {
                                        itemno = 12;
                                        priority = 0.000000;
                                        to="MISSILE__TARGET";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time1 + 1 //isServer && {};" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_2s_">*/
                                class wait_2s_
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="WP_RADIUS";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > _time3 + 2 )"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_5s_">*/
                                class wait_5s_
                                {
                                        itemno = 3;
                                        priority = 0.000000;
                                        to="STATE__1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(time > _time4 + 5 ) "/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "STATE_">*/
                class STATE_
                {
                        name = "STATE_";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"_time4 = time;" \n
                         "" \n
                         "//systemchat ""state"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "HC_ACTIONS__relay">*/
                class HC_ACTIONS__relay
                {
                        name = "HC_ACTIONS__relay";
                        itemno = 8;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "[] spawn A3C_server_fnc_serverMonitorMain; //-- spawn instead of call because we need to wait for client results" \n
                         "" \n
                         "_time2 = time;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "MISSILE__TARGET">*/
                class MISSILE__TARGET
                {
                        name = "MISSILE__TARGET";
                        itemno = 13;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "" \n
                         "" \n
                         "" \n
                         "//systemchat ""LAUNCHER"";" \n
                         "_assignedTargets = [];" \n
                         "{" \n
                         "	(_x getVariable [""A3C_Mon_Server_Var"",[-1,objNull,'']]) params [""_handle"",""_target"",""_ammo""];" \n
                         "	private _removeUnit = true;" \n
                         "	if (!isNull _target) then {	" \n
                         "		if (alive _target) then {" \n
                         "				_assignedTargets pushBack _target;" \n
                         "				_removeUnit = false;	" \n
                         "		};" \n
                         "	};" \n
                         "	if (_removeUnit) then {" \n
                         "		_x removeEventhandler [""FIRED"",_handle];" \n
                         "		A3C_Mon_Server_EH_units = A3C_Mon_Server_EH_units - [_x];" \n
                         "		publicVariable 'A3C_Mon_Server_EH_units';" \n
                         "	};			" \n
                         "} foreach A3C_Mon_Server_EH_units;" \n
                         "{" \n
                         "	_gp = _x;" \n
                         "	[_gp,_sides,_assignedTargets] call A3C_server_fnc_distributeMissileTargets;" \n
                         "} foreach A3C_MON_SERVER_checkGroups;" \n
                         "" \n
                         "_time1 = time;	" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "WP_RADIUS">*/
                class WP_RADIUS
                {
                        name = "WP_RADIUS";
                        itemno = 15;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_slingEvents = _slingEvents select {!isNull (getSlingLoad _x)};" \n
                         "" \n
                         "{" \n
                         "	private _gp = _x;" \n
                         "	private _leader = leader _gp;" \n
                         "	private _vehicle = vehicle _leader;" \n
                         "	private _currentWaypoint = -1;" \n
                         "	private _statements = """";" \n
                         "	private _actionScript = """";" \n
                         "	private _currentWpType = """";" \n
                         "	private _currentWpPos = [];" \n
                         "	private _currentWpIndex = -1;" \n
                         "	private _actionType = """";" \n
                         "	private _condition = """";" \n
                         "" \n
                         "	_currentWpIndex = currentWaypoint _gp;" \n
                         "	_currentWaypoint = [_gp,_currentWpIndex];" \n
                         "	_currentWpType = waypointType _currentWaypoint;" \n
                         "	_currentWpPos = waypointPosition _currentWaypoint;" \n
                         "	_statements = waypointStatements _currentWaypoint;" \n
                         "	_actionScript = _statements select 1;" \n
                         "	_condition = _statements select 0;" \n
                         "" \n
                         "	_actionscript = if (!isNil ""_actionScript"") then {_actionscript} else {""""};" \n
                         "	if ([""CASdistribute"",_actionscript] call BIS_fnc_instring) then {" \n
                         "		if !([""CAS-STRIKE_ACTIVE"",_actionscript] call BIS_fnc_instring) then {" \n
                         "			if (_currentWpPos distance2D _vehicle < 3000 && {(getPosVisual _vehicle) select 2 > 50}) then {" \n
                         "				_actionType = ""ActionCas"";" \n
                         "			} else {" \n
                         "				//-- vehicle approaching the target: make him fly high enough" \n
                         "				private _flyInHeight = (getterrainheightasl _currentWPpos) + 1000;" \n
                         "				[_vehicle, _flyInHeight] remoteExec [""flyInHeight"",_vehicle];" \n
                         "			};" \n
                         "		};" \n
                         "	};" \n
                         "	_isRotor = ((getNumber (configfile >> ""CfgVehicles"" >> typeOf _vehicle >> ""landingSpeed"")) < 10);" \n
                         "	if (_isRotor && { !( _x in _vehicle) } count (assignedCargo _vehicle) == 0) then {" \n
                         "		" \n
                         "		if ([""RAPPEL"",_actionscript] call BIS_fnc_instring) then { //-- looking for FNC name, not wp landing type		" \n
                         "			_slowDownDistance = if (_vehicle isKindOf ""HELICOPTER"") then {1200} else {2500};" \n
                         "			if !([""RAPPELL_ACTIVE"",_actionscript] call BIS_fnc_instring) then {" \n
                         "				if (_currentWpPos distance2D _vehicle < _slowDownDistance) then {" \n
                         "					_actionType = ""HeliRappell"";" \n
                         "				};" \n
                         "			};" \n
                         "		};" \n
                         "	};" \n
                         "	" \n
                         "	//-- give leader a varname so we can convert the actionscript later " \n
                         "	if (_actionType != """") then {" \n
                         "		if ((vehicleVarName _leader) == """") then {" \n
                         "			while {(vehicleVarName _leader) == """"} do {" \n
                         "				//systemchat 'varname loop';" \n
                         "				call compile format" \n
                         "				[" \n
                         "					""" \n
                         "						_leader setvehicleVarName 'A3C_MEMBER_%1_%2';" \n
                         "						A3C_MEMBER_%1_%2 = _leader;" \n
                         "					""," \n
                         "					""Server_UID""," \n
                         "					A3C_VARNAME_INDEX_HC" \n
                         "				];" \n
                         "			};			" \n
                         "		} else {" \n
                         "			call compile format " \n
                         "			[" \n
                         "				""" \n
                         "					%1 = _leader;" \n
                         "					publicVariable '%1';" \n
                         "				""," \n
                         "				(vehiclevarname _leader)" \n
                         "			];" \n
                         "		};" \n
                         "		A3C_VARNAME_INDEX_HC = A3C_VARNAME_INDEX_HC + 1;" \n
                         "		publicVariable 'A3C_VARNAME_INDEX_HC';" \n
                         "	};" \n
                         "	switch _actionType do {" \n
                         "		case (""ActionCas"") : {" \n
                         "			_actionScript = [_actionScript,""this"",str _leader] call A3C_main_fnc_editString; ////-- convert to something we can execute " \n
                         "			call (compile _actionScript);" \n
                         "			[_gp,_currentWpIndex,""ACTIONSCRIPT"",""'CAS_STRIKE_ACTIVE'; ""] call A3C_ai_highCommand_fnc_changeWaypointData;" \n
                         "		};" \n
                         "		case (""PlaneLand"") : {" \n
                         "			_actionScript = [_actionScript,""this"",str _leader] call A3C_main_fnc_editString; //-- convert to something we can execute " \n
                         "			call (compile _actionScript);" \n
                         "			[_gp,_currentWpIndex,""ACTIONSCRIPT"",""'FULL LANDING ACTIVE'; ""] call A3C_ai_highCommand_fnc_changeWaypointData;" \n
                         "		};" \n
                         "		case (""HeliRappell"") : {" \n
                         "			_actionScript = [_actionScript,""this"",str _leader] call A3C_main_fnc_editString; //-- convert to something we can execute " \n
                         "			call (compile _actionScript);	" \n
                         "			[_gp,_currentWpIndex,""ACTIONSCRIPT"",""'A3C_RAPPELL_ACTIVE'; ""] call A3C_ai_highCommand_fnc_changeWaypointData;" \n
                         "		};" \n
                         "	};" \n
                         "	if (_currentWpType == ""LOITER"") then {" \n
                         "		[_currentWaypoint] call A3C_main_fnc_isLoiterCompleted;" \n
                         "	};" \n
                         "	if (_currentWpType != ""HOOK"") then {" \n
                         "		{" \n
                         "			private _v = objectParent _x;" \n
                         "			if (!isNull _v && {_x == driver _v}) then {" \n
                         "				private _slingCargo = getSlingLoad _v;" \n
                         "				if (!isNull _slingCargo && {!(_v in _slingEvents)}) then {" \n
                         "					_slingEvents set [count _slingEvents,_v];" \n
                         "					[_v,_slingCargo] spawn {" \n
                         "						params [""_v"",""_slingCargo""];" \n
                         "						private _originalMass = getMass _slingCargo;" \n
                         "						[_slingCargo,2000] remoteExec [""setMass"",_slingCargo];" \n
                         "						while {!isNull (getSlingLoad _v) && {canMove _v}} do {" \n
                         "							sleep 2;" \n
                         "						};" \n
                         "						[_slingCargo,_originalMass] remoteExec [""setMass"",_slingCargo];" \n
                         "					};" \n
                         "				};" \n
                         "			};" \n
                         "		} foreach units _gp;" \n
                         "	};" \n
                         "} foreach A3C_MON_SERVER_checkGroups;" \n
                         "" \n
                         "_time3 = time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 10;
                                        priority = 0.000000;
                                        to="NEW_CYCLE";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "STATE__1">*/
                class STATE__1
                {
                        name = "STATE__1";
                        itemno = 17;
                        init = /*%FSM<STATEINIT""">*/"_exitCondition = if (isServer) then {[] call {A3C_MISSIONENDED}} else {(isnull (finddisplay 46))};" \n
                         "" \n
                         "//systemchat ""GAME RUNNING CHECK"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "game_running___">*/
                                class game_running___
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="STATE_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(_exitCondition)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "game_quit___">*/
                                class game_quit___
