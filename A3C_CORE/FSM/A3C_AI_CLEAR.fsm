                class End_
                {
                        name = "End_";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"hint ""exit fsm"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "lean_">*/
                class lean_
                {
                        name = "lean_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"_doors = [_doors,[],{_x distance _unit},""ASCEND""] call BIS_fnc_sortBy;" \n
                         "_door = _doors select 0;" \n
                         "_doors = _doors - [_door];" \n
                         "_doorDir = [_building,_door] call A3C_main_fnc_buildingGetDoorDirection;" \n
                         "_dobj = ""SuppressTarget"" createVehicleLocal [0,0,0];" \n
                         "_dobj setpos _door; _dobj setdir _doorDir;" \n
                         "_dobj enablesimulation false;" \n
                         "_relDir = _dobj getreldir _unit;" \n
                         "deleteVehicle _dobj;" \n
                         "_act = false;" \n
                         "_lookDir = 0;" \n
                         "_right = false;" \n
                         "switch (true) do {" \n
                         "	case ((_reldir > 270) && {_reldir < 315}) : {" \n
                         "		_act = true;" \n
                         "		_right = false;" \n
                         "		_lookDir = _doorDir;" \n
                         "	};" \n
                         "	case ((_reldir > 180) && {_reldir < 225}) : {" \n
                         "		_act = true;" \n
                         "		_right = true;" \n
                         "		_lookDir = _doorDir;" \n
                         "	};" \n
                         "	case ((_reldir > 90) && {_reldir < 135}) : {" \n
                         "		_act = true;" \n
                         "		_right = false;" \n
                         "		_lookDir = _doorDir + 180;" \n
                         "	};" \n
                         "	case ((_reldir > 45) && {_reldir < 90}) : {" \n
                         "		_act = true;" \n
                         "		_right = true;" \n
                         "		_lookDir = _doorDir + 180;" \n
                         "	};" \n
                         "};" \n
                         "_unit lookat ([_door,50,_lookdir] call BIS_fnc_RelPos);" \n
                         "if (_act) then {" \n
                         "	if (_right) then {" \n
                         "		_unit playMove ""AadjPknlMstpSrasWrflDright"";" \n
                         "	} else {" \n
                         "		_unit playMove ""AadjPknlMstpSrasWrflDleft"";" \n
                         "	};" \n
                         "};" \n
                         "" \n
                         "_time = time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Player_left_the">*/
                                class Player_left_the
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Exit_";
