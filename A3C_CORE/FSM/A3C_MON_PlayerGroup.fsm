                                        condition=/*%FSM<CONDITION""">*/"(player == leader group player) && (player in units A3C_PLAYERGROUP)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "TeamSwitch">*/
                class TeamSwitch
                {
                        name = "TeamSwitch";
                        itemno = 21;
                        init = /*%FSM<STATEINIT""">*/"_playerUnit removeEventHandler [""KILLED"",A3C_KILLED];" \n
                         "_playerUnit removeEventHandler [""FIRED"",A3C_FIRED];" \n
                         "[] call A3C_Teamswitch;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
