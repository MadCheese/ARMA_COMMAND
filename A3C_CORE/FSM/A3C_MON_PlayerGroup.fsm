                /*%FSM</STATE>*/
                /*%FSM<STATE "wait_3">*/
                class wait_3
                {
                        name = "wait_3";
                        itemno = 30;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "_assignedTargets = [];" \n
                         "{" \n
                         "	_gp = _x;" \n
                         "	{" \n
                         "		_u = _x;" \n
                         "		if (!isPLayer _u) then {" \n
                         "			if (isNull assignedTarget _u) then {" \n
                         "				if (currentWeapon _u == secondaryWeapon _u) then {" \n
                         "					_u doTarget objNull;" \n
                         "					_u lookAt objNull;" \n
                         "					_u disableAI ""AUTOTARGET"";" \n
                         "					_ammo = (getText (configfile >> ""CfgMagazines"" >> currentMagazine _u >> ""ammo""));" \n
                         "					_aiAmmoUsageFlags = getText (configfile >> ""CfgAmmo"" >> _ammo >> ""aiAmmoUsageFlags"");" \n
                         "					if (_aiAmmousageFlags == """") then {" \n
                         "						_aiAmmoUsageFlags = str (getNumber (configfile >> ""CfgAmmo"" >> _ammo >> ""aiAmmoUsageFlags""));" \n
                         "					};" \n
                         "					_targetTypes = if ([""256"",_aiAmmoUsageFlags] call BIS_fnc_instring) then {[""AIR""]} else {[""CAR"",""TANK""]};" \n
                         "					" \n
                         "					_nearTargets = [(side _u),viewDistance,""ENEMY"",position _x,_targetTypes] call MCSS_fnc_NearEntities;" \n
                         "					if (count _nearTargets > 0) then {" \n
                         "						{" \n
                         "							_target = _x;" \n
                         "							if (!(_target in _assignedTargets)) exitWith {" \n
                         "								_assignedTargets pushBackUnique _target;" \n
                         "								" \n
                         "								if (canMove _target) then {" \n
                         "									_u doTarget _target;" \n
                         "									_u doFire _target" \n
                         "								} else {" \n
                         "									_u doTarget objNull;" \n
                         "									_u lookAt objNull;" \n
                         "								};" \n
                         "							};" \n
                         "						} foreach _nearTargets;" \n
                         "					} else {" \n
                         "						if !(_u getVariable [""A3C_ROE"",false]) then {" \n
                         "							_u enableAI ""AUTOTARGET"";" \n
                         "						};" \n
                         "					};" \n
                         "				} else {" \n
                         "					if !(_x getVariable [""A3C_ROE"",false]) then {" \n
                         "						_x enableAI ""AUTOTARGET"";" \n
                         "					};" \n
                         "				};" \n
                         "			} else {" \n
                         "				if ((canMove assignedTarget _u) OR (getDammage (assignedTarget _u) < 0.9)) then {" \n
                         "					_u doTarget objNull;" \n
                         "					_u lookAt objNull;" \n
                         "				};" \n
                         "			};" \n
                         "		};" \n
                         "	} foreach (units _gp);" \n
                         "} foreach (A3C_HC_getAllGroups_Player_Current + [group player]);"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "true_">*/
                                class true_
                                {
                                        itemno = 31;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > _time + 1;"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
