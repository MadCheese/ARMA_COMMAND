                {
                        name = "run_cleanup_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"//[(units group player) - [player]] call A3C_GROUP_RESET;" \n
                         "[] call A3C_JOIN_UNIT;" \n
                         "_time = time;" \n
                         "//systemchat ""array changed"";" \n
                         ""/*%FSM</STATEINIT""">*/;
