class FSM
{
        fsmName = "A3C_MON_PlayerGroup";
        class States
        {
                /*%FSM<STATE "Start_">*/
                class Start_
                {
                        name = "Start_";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private _time = time;" \n
                         "" \n
                         "//-- safety repetition (already present in InitValuesClient" \n
                         "if (isNil ""A3C_isPlayerLeader"") then {" \n
                         "	A3C_isPlayerLeader =" \n
                         "		player == leader group player;" \n
                         "};" \n
                         "" \n
                         "//diag_log ""A3C: STARTING MON_PLAYERGROUP"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "start_conditions">*/
                                class start_conditions
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true && {!(is3DEN)} && {time > (_time + 1)}"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "run_cleanup_">*/
                class run_cleanup_
                {
                        name = "run_cleanup_";
                        itemno = 2;
                        init = /*%FSM<STATEINIT""">*/"" \n
                         "[] call A3C_ai_squad_fnc_joinUnitToPlayerGroup;" \n
                         "_time = time;" \n
                         "" \n
                         "//diag_log ""PLAYERMON: GROUP ARRAY CLEANUP"";" \n
                         "" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Player_Left">*/
                                class Player_Left
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(isnull (finddisplay 46))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_">*/
                                class wait_
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > (_time + 1)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Exit_">*/
                class Exit_
                {
                        name = "Exit_";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/"//diag_log ""EXIT PLAYERMON"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "wait">*/
                class wait
                {
                        name = "wait";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"_time = time;" \n
                         "_playerUnit = player;" \n
                         "" \n
                         "" \n
                         "" \n
                         "" \n
                         "[] call A3C_main_fnc_storeTeamColors;" \n
                         "" \n
                         "if (!(A3C_isPlayerLeader) && {player == leader group player}) then {" \n
                         "	A3C_isPlayerLeader = true;" \n
                         "};" \n
                         "" \n
                         "" \n
                         "//diag_log format [""A3C: LOOP MON_PLAYERGROUP (%1)"", round time];"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Player_Left">*/
                                class Player_Left
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(isnull (finddisplay 46))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Arrays_do_not_match">*/
                                class Arrays_do_not_match
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="run_cleanup_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//(profilenamespace getvariable ""A3C_GROUPUNITS"") isEqualTo units player" \n
                                         "//!( A3C_UNITCOUNTER == (count units group player))" \n
                                         "//({alive _x} count units player) != ({alive _x} count (profilenamespace getvariable ""A3C_GROUPUNITS""))" \n
                                         "//(count units player) != ({!isNull _x} count (profilenamespace getvariable ""A3C_GROUPUNITS"")) // " \n
                                         "!((units player) isEqualTo ((profilenamespace getvariable ""A3C_GROUPUNITS"") select {!isNull  _x}))" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "remoteControl_ON">*/
                                class remoteControl_ON
                                {
                                        itemno = 22;
                                        priority = 0.000000;
                                        to="wait_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"player != cameraOn"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "PLAYER____Leader">*/
                                class PLAYER____Leader
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="Manage_A3C_isPla";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(player != leader group player) && (player in units A3C_PLAYERGROUP)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "__sec_Loop_">*/
                                class __sec_Loop_
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"" \n
                                         "time > (_time + 5)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "assign_TeamColor">*/
                class assign_TeamColor
                {
                        name = "assign_TeamColor";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"[] call A3C_main_fnc_reAssignTeamColors;" \n
                         "" \n
                         "//diag_log ""PLAYERMON: EXIT REMOTE"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "true">*/
                                class true
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"true"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Manage_A3C_isPla">*/
                class Manage_A3C_isPla
                {
                        name = "Manage_A3C_isPla";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"if !(" \n
                         "	[" \n
                         "		player" \n
                         "	] call A3C_ai_shared_fnc_medical_isUnitUnconscious" \n
                         ") then {" \n
                         "	A3C_isPlayerLeader = false;" \n
                         "};" \n
                         "" \n
                         "//diag_log ""PLAYERMON: PLAYER LOST LEAD"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Player_Left">*/
                                class Player_Left
                                {
                                        itemno = 26;
                                        priority = 0.000000;
                                        to="Exit__1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(isnull (finddisplay 46))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "player_took_lead">*/
                                class player_took_lead
                                {
                                        itemno = 20;
                                        priority = 0.000000;
                                        to="Group_Reset";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(player == leader group player) && (player in units A3C_PLAYERGROUP)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
