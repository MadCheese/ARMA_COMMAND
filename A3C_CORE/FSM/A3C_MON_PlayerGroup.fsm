                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "wait_">*/
                                class wait_
                                {
                                        itemno = 11;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"time > (_time + 1)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Exit_">*/
                class Exit_
                {
                        name = "Exit_";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "wait">*/
                class wait
                {
                        name = "wait";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"_time = time;" \n
                         "_playerUnit = player;" \n
                         "" \n
                         "" \n
                         "{" \n
                         "	private _assignedTeam = assignedTeam _x;" \n
                         "	if (_assignedTeam == """") then {_assignedTeam = ""MAIN""};" \n
                         "	_x setVariable [""A3C_ASSIGNEDTEAM"",_assignedTeam];" \n
                         "} foreach ((units player) - [player]);" \n
                         "" \n
                         "//systemchat str time;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "Arrays_do_not_match">*/
                                class Arrays_do_not_match
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="run_cleanup_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"//(profilenamespace getvariable ""A3C_GROUPUNITS"") isEqualTo units player" \n
                                         "//!( A3C_UNITCOUNTER == (count units group player))" \n
                                         "//({alive _x} count units player) != ({alive _x} count (profilenamespace getvariable ""A3C_GROUPUNITS""))" \n
                                         "//(count units player) != ({!isNull _x} count (profilenamespace getvariable ""A3C_GROUPUNITS"")) // " \n
                                         "!((units player) isEqualTo ((profilenamespace getvariable ""A3C_GROUPUNITS"") select {!isNull  _x}))" \n
                                         "" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "__0sec_">*/
                                class __0sec_
                                {
                                        itemno = 13;
                                        priority = 0.000000;
                                        to="HC_ACTIONS__relay";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"false" \n
                                         "//time > (_time + 10)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "player_not_leader">*/
                                class player_not_leader
                                {
                                        itemno = 18;
                                        priority = 0.000000;
                                        to="wait_1";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(player != leader group player) && (player in units A3C_PLAYERGROUP)"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Group_Switch_">*/
                                class Group_Switch_
                                {
                                        itemno = 27;
                                        priority = 0.000000;
                                        to="wait_2";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((alive player) && !(player in units A3C_PLAYERGROUP))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "remoteControl_ON">*/
                                class remoteControl_ON
                                {
                                        itemno = 33;
                                        priority = 0.000000;
                                        to="wait_4";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"player != cameraOn"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "Player_left_the">*/
                                class Player_left_the
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="Exit_";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(isnull (finddisplay 46))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "secondary_s_out">*/
                                class secondary_s_out
                                {
                                        itemno = 29;
                                        priority = 0.000000;
                                        to="wait_3";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"false" \n
                                         "//false" \n
                                         "//{currentWeapon _x == secondaryWeapon _x} count (units player - [player]) > 0" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "HC_ACTIONS__relay">*/
                class HC_ACTIONS__relay
                {
                        name = "HC_ACTIONS__relay";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/"{" \n
                         "	private _colorVar = _x getVariable [""A3C_ASSIGNEDTEAM"",""MAIN""];" \n
                         "	private _assignedTeam = assignedTeam _x;" \n
                         "	if (_colorVar != _assignedTeam) then {" \n
                         "		_x setVariable [""A3C_ASSIGNEDTEAM"",_assignedTeam];" \n
                         "	};" \n
                         "} foreach ((units player) - [player]);" \n
                         "" \n
                         "" \n
                         "" \n
                         "_tgts = [(side player),1000,""ENEMY"",position (vehicle player),[""MAN"",""CAR"",""TANK"",""AIR"",""SHIP""]] call MCSS_fnc_NearEntities;" \n
                         "{" \n
                         "	_t = _x;" \n
                         "	_kn = player knowsabout _t;" \n
                         "	if (_kn > 1.5) then {" \n
                         "		{" \n
                         "				_x reveal [_t,_kn];" \n
                         "		} foreach A3C_HC_getAllGroups_Player_Current;" \n
                         "	};" \n
                         "} foreach _tgts;" \n
                         "" \n
                         "//-- " \n
                         "{" \n
                         "	_gp = _x;" \n
                         "	_x enableAttack false;" \n
                         "	{" \n
                         "		if (behaviour _x in [""SAFE""]) then {" \n
                         "			[_x,""AUTOCOMBAT""] remoteExec [""enableAI"",_x];" \n
                         "		} else {" \n
                         "			[_x,""AUTOCOMBAT""] remoteExec [""disableAI"",_x];" \n
                         "		};" \n
                         "		//_x setskill 1;" \n
                         "		[_x,1] remoteExec [""setSkill"",_x];" \n
                         "		if (!isnull objectParent _x) then {" \n
                         "			if (_x == driver vehicle _x) then {" \n
                         "				if !((vehicle _x) isKindOf ""AIR"") then { //-- make liberation specific" \n
                         "					[vehicle _x,1] remoteExec [""setFuel"",vehicle _x ];" \n
                         "					//vehicle _x setfuel 1;" \n
                         "				};" \n
                         "			};" \n
                         "			//-- prevent loaded AI groups from dismounting in combat mode (more suited for non commanded units)" \n
                         "			//(vehicle _x) setUnloadInCombat [false,false];" \n
                         "			[(vehicle _x),[false,false]] remoteExec [""setUnloadInCombat"",(vehicle _x)];	" \n
                         "		};" \n
                         "		" \n
                         "		//if (combatMode _x == ""RED"") then {" \n
                         "		//	_x setCombatMode ""YELLOW"";" \n
                         "		//};" \n
                         "		if (currentCommand _x == ""STOP"") then {" \n
                         "			[_x, (leader group _x)] remoteExec [""doFollow"",_x];" \n
                         "			//_x doFollow (leader group _x);" \n
                         "		};" \n
                         "	} foreach (units _x);" \n
                         "	//_tgts = [(side player),viewDistance,""ENEMY"",position (vehicle (leader _x)),[""MAN"",""CAR"",""TANK"",""AIR"",""SHIP""]] call MCSS_fnc_NearEntities;" \n
                         "	_tgts =  ((leader _x) targetsQuery [objNull, sideUnknown, """", [], 60]);" \n
                         "	{" \n
                         "		_unit = _x select 1;" \n
                         "		//if ( (_x != leader group _x)  ) then {};" \n
                         "		if (!alive _unit) then {_tgts = _tgts - [_x]};" \n
                         "		if (_unit distance2D (leader _gp) > 1000) then {_tgts = _tgts - [_x]};" \n
                         "		if (side _unit getfriend side player > 0.6) then {_tgts = _tgts - [_x]};" \n
                         "	} foreach 	_tgts;" \n
                         "//OR " \n
                         "	{" \n
                         "		_t = _x select 1;" \n
                         "" \n
                         "		_kn = (leader _gp) knowsabout _t;" \n
                         "		" \n
                         "		if (_kn > 1.5) then {" \n
                         "			if ({unitIsUAV _x} count units _gp > 0) then {" \n
                         "				//{" \n
                         "				//	_u = _x;" \n
                         "				//	if (unitIsUAV _x) then {" \n
                         "						//{_u setSkill [_x,0]} foreach ['spotDistance','spotTime']" \n
                         "				//	};			" \n
                         "				//} foreach (units _gp);" \n
                         "				_kn = _kn * 0.4;" \n
                         "				if ([_t,vehicle (leader _gp)] call MCSS_fnc_LOS_SIMPLE) then {" \n
                         "					player reveal [_t,_kn];" \n
                         "				};" \n
                         "			} else {" \n
                         "				player reveal [_t,_kn];" \n
                         "			};			" \n
                         "		};" \n
                         "		//systemchat format " \n
                         "		//	[" \n
                         "		//		""Hi my name is %1, group leader of %2, i know about a %3 at %4 (%5). His group is %6""," \n
                         "		//		name (leader _gp)," \n
                         "		//		_gp," \n
                         "		//		parseText (getText (configFile >> ""CfgVehicles"" >> typeOf (vehicle leader group _t) >> ""displayName""))," \n
                         "		//		getPos _t," \n
                         "		//		_kn," \n
                         "		//		group _t	" \n
                         "		//	];" \n
                         "		////};" \n
                         "	} foreach _tgts;" \n
                         "} foreach A3C_HC_getAllGroups_Player_Current;"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "nothing_">*/
                                class nothing_
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="wait";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
