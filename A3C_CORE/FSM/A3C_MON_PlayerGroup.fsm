                class Group_Reset
                {
                        name = "Group_Reset";
                        itemno = 21;
                        init = /*%FSM<STATEINIT""">*/"[(units group player) - [player]] call A3C_ui_shared_fnc_resetPlayerGroup;" \n
                         "A3C_isPlayerLeader = true;" \n
                         "" \n
                         "//diag_log ""PLAYERMON: PLAYER TOOK LEAD"";"/*%FSM</STATEINIT""">*/;
