                                class Group_Switch_
                                {
                                        itemno = 27;
                                        priority = 0.000000;
                                        to="wait_2";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"((alive player) && !(player in units A3C_PLAYERGROUP))"/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
