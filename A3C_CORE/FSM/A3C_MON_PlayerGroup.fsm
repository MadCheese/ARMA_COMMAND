                class wait_1
                {
                        name = "wait_1";
                        itemno = 19;
                        init = /*%FSM<STATEINIT""">*/"//systemchat ""lost control"";"/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
