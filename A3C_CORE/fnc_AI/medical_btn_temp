A3C_BTN_HEAL = {




	params ["_mode"]; //-- 0: from dialog || 1: from script
	private ["_healMode"];
	//A3C_MEDICS_ACTIVE = (A3C_MEDICS_ACTIVE + A3C_MEDICS_LB);

	//-- clean up arrays
	//-- medics
	if (count A3C_MEDICS_LB == 0) exitWith {systemchat "A3C: Medic selection empty"};
	//A3C_MEDICS_LB = A3C_MEDICS_LB - A3C_MEDICS_ACTIVE;
	//if (count A3C_MEDICS_LB == 0) exitWith {systemchat "Selected medics are occupied"}; //~~ potentially add patients to active medics instead of exiting

	//-- patients
	//{
	//	if ( (_x in A3C_PATIENTS_DESIGNATED) OR (_x in A3C_PATIENTS_ASSIGNED) ) then {
	//		A3C_PATIENTS_LB = A3C_PATIENTS_LB - [_x];

	//	};
	//} foreach A3C_PATIENTS_LB;
	if (count A3C_PATIENTS_LB == 0) exitWith {systemchat "A3C: No units selected for treatment"};
	A3C_PATIENTS_LB = A3C_PATIENTS_LB - (A3C_PATIENTS_DESIGNATED + A3C_PATIENTS_ASSIGNED);
	if (count A3C_PATIENTS_LB == 0) exitWith {systemchat "A3C: Selected Patients are already scheduled for treatment"};

	//systemchat str A3C_PATIENTS_LB;
	if (_mode == 0) then {
		_chat = switch (true) do {
			case (count A3C_PATIENTS_LB == 1) : {_u = A3C_PATIENTS_LB select 0; if (_u == player) then {"I need help!"} else {format ["Heal %1",name _u]} };
			case (count A3C_PATIENTS_LB > 1) : {"Heal those soldiers"};
		};
		player groupchat _chat;
	};
	_healMode = if ((count A3C_PATIENTS) > 1) then {1} else {0};


	//-- update designated targets
	if (count (A3C_MEDICS_ACTIVE + A3C_MEDICS_LB) > 0) then {
		{
			if !(_x in A3C_PATIENTS_ASSIGNED) then {
				//systemchat "unit added to healing cue";
				A3C_PATIENTS_DESIGNATED pushBackUnique _x; //-- Active patients can be updated immideately. Only active medics have to be added individually since they may outnumber patients
			};
		} foreach A3C_PATIENTS_LB;
	};

//	systemchat str [A3C_MEDICS_LB,A3C_MEDICS_ACTIVE,A3C_PATIENTS_DESIGNATED,A3C_PATIENTS_ASSIGNED];
//	if (count (A3C_MEDICS_LB - A3C_MEDICS_ACTIVE) == 0) exitWith {
//		//-- update UI for added patients
//		[] call A3C_UI_RADIAL_UPDATE_MEDICAL;
//	};
//systemchat '2';

	{
		_u = _x;
		if (currentCommand _u == "STOP") then {
			_pu = false;

			if (_u in A3C_PATIENTS_DESIGNATED) then {
				_pu = true;
				A3C_PATIENTS_DESIGNATED = A3C_PATIENTS_DESIGNATED - [_u];
			};

			A3C_MEDICS_LB = A3C_MEDICS_LB - [_u];
			_u = [_u] call A3C_Replace_Unit;
			A3C_MEDICS_LB pushBackUnique _u;
			if (_pu) then {
				A3C_PATIENTS_DESIGNATED pushBackUnique _u;
			};

			sleep 0.1;
		};
	} foreach A3C_MEDICS_LB;



	//-- sort medics: if medic(s) is also patient(s), have him in front of array so he will then chose himself as nearest patient
	A3C_MEDICS_LB = [A3C_MEDICS_LB,[],{_i = if (_x in A3C_PATIENTS_DESIGNATED) then {1} else {0}; _i},"DESCEND"] call BIS_fnc_sortBy;

	//[A3C_MEDICS_LB,A3C_PATIENTS_DESIGNATED] spawn {
	//	sleep 2;
	//	player sidechat str (_this select 0);
	//	player commandchat str (_this select 1);
	//};

	//sleep 0.5;
//	systemchat str A3C_MEDICS_LB;
	{

		private ["_medic","_patient"];
		_medic = _x;
		//systemChat format ["%1-1",_foreachINdex];
		if ((count A3C_PATIENTS_DESIGNATED) == 0) exitwith {
			A3C_MEDICS_ACTIVE = A3C_MEDICS_ACTIVE - [_medic];
		};
		//systemChat format ["%1-2",_foreachINdex];
		//if ((count A3C_MEDICS_ACTIVE) == 0) exitwith {};
		A3C_PATIENTS_DESIGNATED = [A3C_PATIENTS_DESIGNATED,[],{_x distance2d _medic},"ASCEND"] call BIS_fnc_sortBy;
		if (_medic in A3C_PATIENTS_DESIGNATED) then {
			_patient = _medic;
		} else {
			_patient = (A3C_PATIENTS_DESIGNATED select 0);
		};

		A3C_PATIENTS_DESIGNATED = A3C_PATIENTS_DESIGNATED - [_patient]; //-- patient is being healed >> remove from active patient list
		[_medic,_patient,_healmode,(expecteddestination _medic),_forEachIndex] spawn {

			params ["_healer","_patient","_hm","_expDest","_index"];
			private ["_script","_dir"];


			//_expP = if (((_expDest select 0) distance2d [0,0,0] ) == 0) then {(position _healer)} else {(_expDest select 0)};
			[_healer] call A3C_UNIT_STORE_DESTINATION;
			_array = [];
			_dir = getdir _healer;
			_script = {};
			sleep (1 * _index);
			A3C_MEDICS_ACTIVE pushBackUnique _healer;
			A3C_PATIENTS_DESIGNATED = A3C_PATIENTS_DESIGNATED - [_patient]; //~~ needed?

			//systemchat str _healer;

			if (_hm == 1) then {
				//-- HEAL ALL
				while {alive _healer} do {
					systemchat str [_healer == _patient];
					//systemchat "heal all";
					_script = [_healer,_patient] spawn A3C_HEAL;
					sleep 0.1;
					//-- update UI PRE HEAL
					[] call A3C_UI_RADIAL_UPDATE_MEDICAL;

					waituntil {scriptDone _script};
					//-- update UI POST HEAL
					[] call A3C_UI_RADIAL_UPDATE_MEDICAL;
					//player sidechat str _script;
					systemchat 'he0';
					if (currentcommand _healer == "STOP" && {!( ((expectedDestination _healer ) select 1) == "LEADER PLANNED")}) exitwith {
						//systemchat 'medi stop';
					};
					//if ((((expectedDestination _healer ) select 0) distance2d _patient) > 5) exitWith {};
					if (({_it = _x; ({[_x,_it] call MCSS_fnc_isInString} count ["Medi","FirstAid","FAK"] ) > 0} count items _u) == 0 ) exitWith {
						//systemchat str ( count A3C_MEDICS_ACTIVE);
						if (count A3C_PATIENTS_DESIGNATED > 0) then {
							if (count A3C_MEDICS_ACTIVE == 1) then {
								_healer groupChat format ["I am out of supplies, can not attend to %1 units", count A3C_PATIENTS_DESIGNATED];
								A3C_PATIENTS_DESIGNATED = [];
							};
						};
					};
					systemchat 'he1';
					if ((count A3C_PATIENTS_DESIGNATED) == 0) exitwith {};
					systemchat 'he2';
					if (({_x distance2d _healer < 80} count A3C_PATIENTS_DESIGNATED) == 0) exitwith {};
					player commandChat str A3C_PATIENTS_DESIGNATED;
					A3C_PATIENTS_DESIGNATED = [A3C_PATIENTS_DESIGNATED,[],{_x distance2d _healer},"ASCEND"] call BIS_fnc_sortBy;
					_patient = A3C_PATIENTS_DESIGNATED select 0;
					player commandChat str [_patient];
					A3C_PATIENTS_DESIGNATED = A3C_PATIENTS_DESIGNATED - [_patient];

				};
			} else {
				//systemchat str (expectedDestination _healer);

				_script = [_healer,_patient] spawn A3C_HEAL;
				sleep 0.1;
				//-- update UI PRE HEAL
				[] call A3C_UI_RADIAL_UPDATE_MEDICAL;
				waituntil {scriptDone _script};
				//systemchat "2";
				//-- update UI POST HEAL
				[] call A3C_UI_RADIAL_UPDATE_MEDICAL;

			};

			//-- healing task completed

			//if ((_healer distance2d _patient) < 5) then {
				//private _expDC = (expectedDestination _healer );
				//_expDC = if (count _expDC > 0) then {(_expDC select 1)} else {""}; //-- best bet to prevent empty array test error
				//player commandchat str _expDC ;
				//sleep 0.5;
				// not stopped and not in "leader planned
				[_healer] call A3C_UNIT_RESUME_DESTINATION;
				//systemchat 'done';
			//};


			//-- last unit has cancelled >> reset designated patients
			if (count A3C_PATIENTS_DESIGNATED > 0) then {
				if (A3C_MEDICS_ACTIVE isEqualTo [_healer]) then {
					A3C_PATIENTS_DESIGNATED = [];
				};
			};
			A3C_MEDICS_ACTIVE = A3C_MEDICS_ACTIVE - [_healer];
			//-- update UI
			if (A3C_LBR_1 == 'MEDICAL') then {
				if (ctrlShown (findDisplay 100040 displayCtrl 8056)) then {
					[] spawn {
						sleep 0.5;
						[] call A3C_UI_RADIAL_UPDATE_MEDICAL;
					};
				};

			};
		};
		sleep 0.2;
	} foreach A3C_MEDICS_LB;
};